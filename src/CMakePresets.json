{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "win32",
      "displayName": "WoWClient2 Win32",
      "description": "Win32 Visual Studio build with binary files in src/out.",
      "generator": "Visual Studio 18 2026",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/out",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo;MinSizeRel",
        "WOW_RUNTIME_WORKING_DIRECTORY": "E:/World of Warcraft/out"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win32-debug",
      "configurePreset": "win32",
      "configuration": "Debug"
    },
    {
      "name": "win32-release",
      "configurePreset": "win32",
      "configuration": "Release"
    }
  ]
}

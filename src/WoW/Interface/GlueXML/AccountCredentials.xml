<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<Script file="AccountCredentials.lua"/>
	<Frame name="AccountLoginCredentials" parent="AccountLoginUI" hidden="true" frameStrata="HIGH" toplevel="true">
		<Size>
			<AbsDimension x="360" y="132"/>
		</Size>
		<Anchors>
			<Anchor point="TOP">
				<Offset>
					<AbsDimension x="8" y="-250"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="OVERLAY">
				<FontString inherits="GlueFontNormalSmall" text="Account Name" justifyH="LEFT">
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset><AbsDimension x="58" y="-2"/></Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString inherits="GlueFontNormalSmall" text="Password" justifyH="LEFT">
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset><AbsDimension x="58" y="-64"/></Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<EditBox name="AccountLoginAccountEdit" letters="64">
				<Size><AbsDimension x="156" y="36"/></Size>
				<Anchors>
					<Anchor point="TOP"><Offset><AbsDimension x="0" y="-23"/></Offset></Anchor>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture file="Interface\Glues\Common\Glues-EditBox-Background">
							<Size><AbsDimension x="280" y="64"/></Size>
							<Anchors>
								<Anchor point="TOP">
									<Offset><AbsDimension x="0" y="12"/></Offset>
								</Anchor>
							</Anchors>
						</Texture>
					</Layer>
				</Layers>
				<Scripts>
					<OnEnterPressed>AccountCredentials_AccountEnter();</OnEnterPressed>
					<OnTabPressed>AccountCredentials_AccountTab();</OnTabPressed>
					<OnEscapePressed>AccountCredentials_Hide();</OnEscapePressed>
				</Scripts>
				<FontString inherits="GlueEditBoxFont" justifyH="LEFT"/>
			</EditBox>
			<EditBox name="AccountLoginPasswordEdit" letters="128" password="true">
				<Size><AbsDimension x="156" y="36"/></Size>
				<Anchors>
					<Anchor point="TOP"><Offset><AbsDimension x="0" y="-85"/></Offset></Anchor>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture file="Interface\Glues\Common\Glues-EditBox-Background">
							<Size><AbsDimension x="280" y="64"/></Size>
							<Anchors>
								<Anchor point="TOP">
									<Offset><AbsDimension x="0" y="12"/></Offset>
								</Anchor>
							</Anchors>
						</Texture>
					</Layer>
				</Layers>
				<Scripts>
					<OnEnterPressed>AccountLogin_Login();</OnEnterPressed>
					<OnTabPressed>AccountCredentials_PasswordTab();</OnTabPressed>
					<OnEscapePressed>AccountCredentials_Hide();</OnEscapePressed>
				</Scripts>
				<FontString inherits="GlueEditBoxFont" justifyH="LEFT"/>
			</EditBox>
		</Frames>
	</Frame>
</Ui>
